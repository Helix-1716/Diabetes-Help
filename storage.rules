rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to upload their own avatar
    match /avatars/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow public read access to avatars
    match /avatars/{userId} {
      allow read: if true;
    }
  }
}
